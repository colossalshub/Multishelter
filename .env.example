# SQLite database file. Path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Required in production. Use a long random string (32+ bytes).
# Changing this value invalidates existing sessions.
SESSION_SECRET="replace-with-a-long-random-string"

# Directory for animal photos and private documents. Not web-accessible.
STORAGE_PATH="./storage"

# bcrypt cost. Use 12 in production. Tests may set a lower value.
BCRYPT_ROUNDS="12"

# Set to "true" only when the app is behind a trusted reverse proxy.
TRUST_PROXY="false"

# Demo data is never loaded automatically. Set to "true" to allow npm run db:seed-demo.
ALLOW_DEMO_SEED="false"

# Initial platform administrator (used only by npm run admin:create).
# ADMIN_EMAIL="admin@example.com"
# ADMIN_NAME="Platform Admin"
# ADMIN_PASSWORD="use-a-unique-password"
# Set ADMIN_RESET=true to replace the password of an existing account.
# ADMIN_RESET="false"
